{
  "version": 1,
  "package": {
    "name": "cadkit"
  },
  "sourceRoots": [
    "haxe/src"
  ],
  "scopeSourceRoots": false,
  "dependencies": {
    "kinematicskit": {
      "path": "../kinematicskit"
    },
    "projectkit": {
      "path": "../projectkit"
    }
  },
  "ffi": {
    "interfaces": [
      "haxe/abi/CadKit.hxi"
    ],
    "projections": [
      "haxe/abi/CadKit.hxmap"
    ]
  },
  "native": {
    "cmake": {
      "source": "native",
      "target": "cadkit-core",
      "library": "cadkit-core",
      "inputs": [
        "native/CMakeLists.txt",
        "CMakeLists.txt",
        "core/CMakeLists.txt",
        "core/include/cadkit.h",
        "core/src/cadkit.cpp"
      ]
    }
  },
  "target": "host"
}
