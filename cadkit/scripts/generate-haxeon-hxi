#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
haxeon_root="${HAXEON_ROOT:-$repo_root/../haxeon}"
import_target="${HAXEON_IMPORT_TARGET:-x86_64-linux-gnu}"
abi_target="${HAXEON_TARGET:-portable-abi64}"
temporary="$(mktemp)"
trap 'rm -f -- "$temporary"' EXIT

"$haxeon_root/scripts/haxeon-ffi-import" \
	"--target=$import_target" \
	--library=cadkit-core \
	--interface=CadKit \
	--source-label=core/include/cadkit.h \
	"--output=$temporary" \
	"$repo_root/core/include/cadkit.h"

# CadKit's public ABI uses only fixed-width scalars and explicitly generated
# layouts, so publish it under the same portable ABI target as its consumers.
sed -e "1s/for $import_target/for $abi_target/" \
	-e "2s/@target(\"$import_target\")/@target(\"$abi_target\")/" \
	"$temporary" > "$repo_root/haxe/abi/CadKit.hxi"
