#!/usr/bin/env bash
set -euo pipefail

# The operator link (pendant, host link, cabinet node): the wire schema's generated outputs, the Rust
# crates' tests, and the MCU build. The Haxe side (profile, compiler, frames) runs in test-haxeon.
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
materia_root="$(cd -- "$repo_root/.." && pwd)"
cd "$materia_root"

python3 -B -m tools.wire check --config machinekit/operator_link.json
python3 -B -m unittest discover -s tools/wire/tests -t .
cargo test --offline --manifest-path machinekit/operator_link/Cargo.toml
cargo test --offline --manifest-path machinekit/cabinet_node/Cargo.toml
if rustup target list --installed 2>/dev/null | grep -qx thumbv7em-none-eabihf; then
	cargo build --offline --manifest-path machinekit/cabinet_node/Cargo.toml --target thumbv7em-none-eabihf
else
	echo "skipping the MCU build: thumbv7em-none-eabihf is not installed" >&2
fi
