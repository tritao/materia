#!/usr/bin/env bash
set -euo pipefail

# The operator link (pendant, host link, cabinet node): the wire schema's generated outputs, the Rust
# crates' tests, and the MCU build. The Haxe side (profile, compiler, frames) runs in test-haxeon.
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
materia_root="$(cd -- "$repo_root/.." && pwd)"
cd "$materia_root"

# The repo formats its Haxe, which rewrites the generated wire classes, so `check` (raw generator output) cannot hold for them:
# regenerate, format, and require that nothing differs from what is committed.
python3 -B -m tools.wire generate --config machinekit/operator_link.json
./haxeon/scripts/haxeon fmt machinekit/haxe/src/machinekit/operator/wire/*.hx
git diff --exit-code -- machinekit/haxe/src/machinekit/operator/wire machinekit/operator_link/src/operator_wire.rs machinekit/operator_link/schema/operator.lock.json
python3 -B -m unittest discover -s tools/wire/tests -t .
cargo test --offline --manifest-path machinekit/operator_link/Cargo.toml
cargo test --offline --manifest-path machinekit/pendant_core/Cargo.toml
cargo test --offline --manifest-path machinekit/cabinet_node/Cargo.toml
if rustup target list --installed 2>/dev/null | grep -qx thumbv7em-none-eabihf; then
	cargo build --offline --manifest-path machinekit/cabinet_node/Cargo.toml --target thumbv7em-none-eabihf
else
	echo "skipping the MCU build: thumbv7em-none-eabihf is not installed" >&2
fi
# Pendant firmware skeleton for the bench chip and the pendant's own chip (H503), when their targets are installed.
firmware="machinekit/pendant_firmware/Cargo.toml"
installed="$(rustup target list --installed 2>/dev/null || true)"
if grep -qx thumbv7em-none-eabihf <<<"$installed"; then
	cargo build --offline --release --manifest-path "$firmware" --target thumbv7em-none-eabihf --features nucleo-g474
fi
if grep -qx thumbv8m.main-none-eabihf <<<"$installed"; then
	cargo build --offline --release --manifest-path "$firmware" --target thumbv8m.main-none-eabihf --features h503
else
	echo "skipping the H503 firmware build: thumbv8m.main-none-eabihf is not installed" >&2
fi
