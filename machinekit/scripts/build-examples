#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
materia_root="$(cd -- "$repo_root/.." && pwd)"
haxeon="$materia_root/haxeon/scripts/haxeon"

"$haxeon" build --project "$repo_root/examples/picking-station/haxeon.json"
"$haxeon" build --project "$repo_root/examples/haxeon.json"
"$haxeon" build --project "$repo_root/examples/robot-arm/haxeon.json"
"$haxeon" build --project "$repo_root/examples/robot-arm/authoring/haxeon.json"
