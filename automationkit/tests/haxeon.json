{
	"version": 1,
	"package": { "name": "materia-automation-tests" },
	"entry": "tests.AutomationTests",
	"sourceRoots": ["src"],
	"dependencies": {
		"haxeon-platform": { "path": "../../haxeon/packages/platform" },
		"materia-automation": { "path": ".." }
	},
	"native": {
		"cmake": {
			"source": "../../robotkit/robotd/native",
			"target": "robotd_native",
			"libraries": ["nativekit", "nativekit_scene", "nativekit_sim_core", "trajectory_core", "robotkit_runtime", "robotkit_inference"],
			"inputs": [
				"../../robotkit/robotd/native/CMakeLists.txt",
				"../../robotkit/CMakeLists.txt",
				"../../robotkit/runtime/CMakeLists.txt",
				"../../robotkit/runtime/include/robotkit_runtime.h",
				"../../haxeon/vendor/nativekit/CMakeLists.txt",
				"../../simkit/CMakeLists.txt"
			]
		}
	},
	"target": "host",
	"outputDir": "build"
}
