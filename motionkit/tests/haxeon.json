{
  "version": 1,
  "package": {
    "name": "motionkit-tests"
  },
  "entry": "MotionKitBootstrapTests",
  "sourceRoots": [
    "src",
    "../../machinekit/examples/corexy"
  ],
  "dependencies": {
    "cadbridge": {
      "path": "../../robotkit/cadbridge"
    },
    "machinekit": {
      "path": "../../machinekit"
    },
    "processkit": {
      "path": "../../processkit"
    },
    "motionkit-robot": {
      "path": "../robot"
    },
    "haxeon-platform": {
      "path": "../../haxeon/packages/platform"
    },
    "robotkit": {
      "path": "../../robotkit"
    }
  },
  "native": {
    "cmake": {
      "source": "../../robotkit/robotd/native",
      "target": "robotd_native",
      "inputs": [
        "../../robotkit/robotd/native/CMakeLists.txt",
        "../../robotkit/CMakeLists.txt",
        "../../robotkit/runtime/CMakeLists.txt",
        "../../robotkit/runtime/include/robotkit_runtime.h",
        "../../robotkit/runtime/include/robotkit_simkit.h",
        "../../motionkit/native/CMakeLists.txt",
        "../../motionkit/native/include/motionkit.h",
        "../../trajectorykit/native/src/trajectory.cpp",
        "../../trajectorykit/native/src/validation.cpp",
        "../../trajectorykit/native/CMakeLists.txt",
        "../../trajectorykit/native/include/trajectory_core.h",
        "../../trajectorykit/native/include/trajectory_core.hpp",
        "../../motionkit/native/src/generator.cpp",
        "../../motionkit/native/src/path.cpp",
        "../../motionkit/native/vendor/ruckig/CMakeLists.txt",
        "../../motionkit/native/vendor/toppra/cpp/CMakeLists.txt",
        "../../nativekit/CMakeLists.txt",
        "../../simkit/CMakeLists.txt"
      ]
    }
  },
  "target": "host",
  "outputDir": "build"
}
