		d6: f64 @offset(48);
		offsets: array<f64, 6> @offset(56);
		sign_corrections: array<i8, 6> @offset(104);
	}
	handle mk_path_handle : u32 @destroy("mk_path_destroy");
	handle mk_time_law_handle : u32 @destroy("mk_time_law_destroy");
}
