{
  "version": 1,
  "package": {
    "name": "motionkit"
  },
  "sourceRoots": [
    "haxe"
  ],
  "scopeSourceRoots": false,
  "dependencies": {
    "trajectorykit": {
      "path": "../trajectorykit"
    }
  },
  "ffi": {
    "interfaces": [
      "native/bindings/motionkit.hxi"
    ]
  },
  "target": "host",
  "native": {
    "cmake": {
      "source": "native",
      "target": "motionkit_core",
      "library": "motionkit_core",
      "inputs": [
        "native/CMakeLists.txt",
        "native/include/motionkit.h",
        "native/include/motionkit.hpp",
        "native/src/generator.cpp",
        "native/src/path.cpp",
        "native/src/configuration.cpp",
        "native/src/eaik.cpp",
        "native/src/redundancy_qp.cpp",
        "../kinematicskit/native/vendor/proxsuite/include",
        "../kinematicskit/native/src/proxsuite_config",
        "native/vendor/eaik/CPP/src",
        "native/vendor/eaik/CPP/external/ik-geo/cpp/subproblems"
      ]
    }
  }
}
