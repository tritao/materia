{
	"version": 1,
	"package": { "name": "robotd" },
	"entry": "robotd.Main",
	"sourceRoots": ["src"],
	"dependencies": {
		"nativekit": { "path": "../nativekit" },
		"robotkit": { "path": "../robotkit" }
	},
	"native": {
		"cmake": {
			"source": "native",
			"target": "robotd_native",
			"inputs": ["native/CMakeLists.txt", "../nativekit", "../robotkit"]
		}
	},
	"target": "host",
	"outputDir": "build"
}
