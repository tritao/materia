{
  "version": 1,
  "package": {
    "name": "scenekit"
  },
  "sourceRoots": [
    "scene/bindings/haxe",
    "scene_render/bindings/haxe"
  ],
  "scopeSourceRoots": false,
  "dependencies": {
    "haxeon-platform": { "path": "../haxeon/packages/platform" },
    "haxeon-gpu": { "path": "../haxeon/packages/gpu" }
  },
  "ffi": {
    "interfaces": [
      "scene/bindings/nativekit-scene.hxi",
      "scene_render/bindings/nativekit-scene-render.hxi"
    ],
    "projections": [
      "scene_render/bindings/nativekit-scene-render.hxmap"
    ]
  },
  "target": "host"
}
