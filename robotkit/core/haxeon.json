{
  "version": 1,
  "package": {
    "name": "robotkit-core"
  },
  "sourceRoots": [
    "haxe"
  ],
  "scopeSourceRoots": false,
  "dependencies": {
    "nativekit": {
      "path": "../../nativekit"
    },
    "trajectorykit": {
      "path": "../../trajectorykit"
    }
  },
  "target": "host",
