{
	"version": 1,
	"package": { "name": "robotkit" },
	"sourceRoots": ["haxe"],
	"scopeSourceRoots": false,
	"dependencies": {
		"nativekit": { "path": "../nativekit" },
		"simkit": { "path": "../simkit" },
		"visionkit": { "path": "../visionkit" }
	},
	"ffi": {
		"interfaces": [
			"runtime/bindings/robotkit-runtime.hxi",
			"runtime/bindings/robotkit-simkit.hxi",
			"policy/bindings/robotkit-policy.hxi"
		],
		"projections": [
			"runtime/bindings/robotkit-runtime.hxmap",
			"runtime/bindings/robotkit-simkit.hxmap",
			"policy/bindings/robotkit-policy.hxmap"
		]
	},
	"target": "host"
}
