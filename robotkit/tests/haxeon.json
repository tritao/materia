{
	"version": 1,
	"package": { "name": "robotkit-world-tests" },
	"entry": "tests.RobotWorldTests",
	"sourceRoots": ["src", "../../sensorkit/sensor_io/haxe"],
	"dependencies": {
		"nativekit": { "path": "../../nativekit" },
		"robotkit": { "path": ".." },
		"motionkit-robot": { "path": "../../motionkit/robot" }
	},
	"native": {
		"cmake": {
			"source": "../robotd/native",
			"target": "robotd_native",
			"inputs": [
				"../robotd/native/CMakeLists.txt",
				"../CMakeLists.txt",
				"../runtime/CMakeLists.txt",
				"../runtime/include/robotkit_runtime.h",
				"../runtime/include/robotkit_simkit.h",
				"../../motionkit/native/CMakeLists.txt",
				"../../motionkit/native/include/motionkit.h",
				"../../motionkit/native/src/trajectory.cpp",
				"../../motionkit/native/src/validation.cpp",
				"../../motionkit/native/src/generator.cpp",
				"../../motionkit/native/vendor/ruckig/CMakeLists.txt",
				"../../nativekit/CMakeLists.txt",
				"../../simkit/CMakeLists.txt"
			]
		}
	},
	"target": "host",
	"outputDir": "build"
}
