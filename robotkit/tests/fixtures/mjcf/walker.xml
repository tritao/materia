<!-- A one-legged walker that exercises what robotkit_mjcf_import reads:
     default classes and childclass, degree angles, fromto geometry, a joint
     anchor offset, a jointless (fixed) body, geoms that collide only through
     explicit contact pairs, a geom that never collides, a visual mesh,
     joint actuators and an IMU site. -->
<mujoco model="walker-fixture">
  <compiler angle="degree"/>
  <default>
    <default class="walker">
      <joint damping="0.5" armature="0.01"/>
      <default class="leg">
        <joint axis="0 1 0" range="-90 45" actuatorfrcrange="-40 40"/>
      </default>
      <default class="collision">
        <geom contype="1" conaffinity="1" group="3"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" density="0"/>
      </default>
    </default>
  </default>
  <asset>
    <mesh name="plate" vertex="-0.1 -0.1 0  0.1 -0.1 0  0.1 0.1 0  -0.1 0.1 0  0 0 0.05"/>
  </asset>
  <worldbody>
    <body name="torso" pos="0 0 1" childclass="walker">
      <freejoint name="root"/>
      <inertial pos="0 0 0.05" mass="10" diaginertia="0.3 0.2 0.1"/>
      <geom name="torso_box" class="collision" type="box" size="0.15 0.1 0.2"/>
      <geom class="visual" mesh="plate" pos="0 0 0.2"/>
      <site name="imu" pos="0.02 0 0.1"/>
      <body name="left_thigh" pos="0 0.1 -0.2">
        <inertial pos="0 0 -0.2" mass="3" diaginertia="0.05 0.05 0.01"/>
        <joint name="left_hip" class="leg"/>
        <geom class="collision" type="capsule" size="0.05" fromto="0 0 0 0 0 -0.4"/>
        <body name="left_shin" pos="0 0 -0.4">
          <inertial pos="0 0 -0.2" mass="2" diaginertia="0.03 0.03 0.005"/>
          <joint name="left_knee" axis="0 1 0" range="0 150" pos="0 0 0.02"/>
          <geom class="collision" type="cylinder" size="0.04 0.2" pos="0 0 -0.2"/>
          <body name="left_foot" pos="0 0 -0.42">
            <inertial pos="0.03 0 0" mass="0.5" diaginertia="0.002 0.002 0.001"/>
            <geom name="left_toe" type="sphere" size="0.02" pos="0.08 0 -0.02" contype="0" conaffinity="0"/>
            <geom name="left_heel" type="sphere" size="0.02" pos="-0.04 0 -0.02" contype="0" conaffinity="0"/>
            <geom name="left_ghost" type="capsule" size="0.01 0.03" contype="0" conaffinity="0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <contact>
    <pair geom1="left_toe" geom2="torso_box" condim="4" friction="0.8 0.8 0.02 0.001 0.001" solref="0.01 0.9"/>
    <pair geom1="left_heel" geom2="torso_box"/>
  </contact>
  <actuator>
    <motor name="left_hip" joint="left_hip" gear="2" forcerange="-20 20"/>
    <position name="left_knee" joint="left_knee" kp="50"/>
  </actuator>
  <sensor>
    <accelerometer site="imu"/>
    <gyro site="imu"/>
  </sensor>
</mujoco>
