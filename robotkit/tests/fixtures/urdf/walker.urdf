<?xml version="1.0"?>
<!-- A one-legged walker that exercises what UrdfLoader reads: a floating joint
     from world, inertia given in a rotated inertial frame, box, cylinder and
     sphere collision, a collision mesh reference, a visual mesh, a mimic
     joint, a link without inertial, and a simple transmission. -->
<robot name="walker-urdf">
  <link name="world"/>
  <joint name="root" type="floating">
    <parent link="world"/>
    <child link="torso"/>
  </joint>
  <link name="torso">
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="10"/>
      <inertia ixx="0.3" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://walker/meshes/torso.stl"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.3 0.2 0.4"/></geometry>
    </collision>
  </link>
  <joint name="left_hip" type="revolute">
    <parent link="torso"/>
    <child link="left_thigh"/>
    <origin xyz="0 0.1 -0.2" rpy="0 0 0"/>
    <axis xyz="0 2 0"/>
    <limit lower="-1.5707963" upper="0.7853982" effort="40" velocity="10"/>
    <dynamics damping="0.5"/>
  </joint>
  <link name="left_thigh">
    <inertial>
      <origin xyz="0 0 -0.2"/>
      <mass value="3"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.01"/>
    </inertial>
    <collision>
      <origin xyz="0 0 -0.2"/>
      <geometry><cylinder radius="0.05" length="0.4"/></geometry>
    </collision>
  </link>
  <joint name="left_knee" type="revolute">
    <parent link="left_thigh"/>
    <child link="left_foot"/>
    <origin xyz="0 0 -0.4" rpy="1.5707963267948966 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.6" effort="30" velocity="10"/>
  </joint>
  <link name="left_foot">
    <inertial>
      <origin xyz="0.03 0 0" rpy="0 0 1.5707963267948966"/>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0005"/>
    </inertial>
    <collision>
      <origin xyz="0.08 0 -0.02"/>
      <geometry><sphere radius="0.02"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="package://walker/meshes/foot.stl"/></geometry>
    </collision>
  </link>
  <joint name="left_toe" type="revolute">
    <parent link="left_foot"/>
    <child link="left_toe_tip"/>
    <origin xyz="0.1 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="1.5" effort="5" velocity="5"/>
    <mimic joint="left_knee" multiplier="0.5" offset="0.1"/>
  </joint>
  <link name="left_toe_tip"/>
  <transmission name="left_hip_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_hip"><hardwareInterface>EffortJointInterface</hardwareInterface></joint>
    <actuator name="left_hip_motor"><mechanicalReduction>2</mechanicalReduction></actuator>
  </transmission>
</robot>
