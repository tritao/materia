		virtual_device_actuator_direction_setup_ticks: array<u16, 64> @offset(2832);
		virtual_device_actuator_skew_bound: array<f64, 64> @offset(2960);
		/**
		 * < 64 NUL-terminated ASCII IDs, 64 bytes each.
		 */
		virtual_device_actuator_ids: array<u8, 4096> @offset(3472);
		/**
		 * Optional origin-centred link boxes; zero extents preserve legacy shape policy.
		 */
		collision_half_extents: array<f64, 3072> @offset(7568);
		/**
		 * Optional physical-part convex hulls; 4..64 local XYZ vertices per link.
		 */
		collision_hull_count: array<u32, 1024> @offset(32144);
		collision_hull_vertices: array<f64, 196608> @offset(36240);
		closure_count: u32 @offset(1609104);
		closures: array<rk_simulation_closure_desc, 64> @offset(1609112);
		/**
		 * < 1 full, 2 minimal; zero defaults to full.
		 */
		virtual_device_profile: u32 @offset(1613208);
		/**
		 * Optional tool collision geoms, expressed in the flange link frame.
		 */
		tool_link_index: u32 @offset(1613212);
		tool_piece_count: u32 @offset(1613216);
		tool_piece_vertex_count: array<u32, 16> @offset(1613220);
		tool_piece_vertices: array<f64, 3072> @offset(1613288);
		tool_margin: f64 @offset(1637864);
		tool_gap: f64 @offset(1637872);
		/**
		 * Optional primitive collision shapes. A link that has any collides
		 * through them together with its hull or box above, if given, and its
		 * tool pieces; otherwise the link keeps the legacy shape policy.
		 */
		link_shape_count: u32 @offset(1637880);
		link_shapes: array<rk_simulation_link_shape, 256> @offset(1637888);
		/**
		 * Optional explicit contacts between link shapes.
		 */
		contact_pair_count: u32 @offset(1672704);
		contact_pairs: array<rk_simulation_contact_pair, 128> @offset(1672712);
		/**
		 * Optional convex hulls of links built from several rigid parts, one per
		 * part. A link collides through a compound of its hull or box above, these
		 * hulls, its primitives and its tool pieces.
		 */
		link_hull_count: u32 @offset(1679880);
		link_hulls: array<rk_simulation_link_hull, 512> @offset(1679888);
	}
	/**
	 * World-frame twist of one body: metres per second and radians per second.
	 */
	struct rk_simulation_twist @layout(56, 8) {
		struct_size: u32 @offset(0) @struct_size;
		reserved0: u32 @offset(4);
		linear: array<f64, 3> @offset(8);
		angular: array<f64, 3> @offset(32);
	}
	/**
	 * A force (N) and torque (N m), world frame, at a body's centre of mass.
	 */
	struct rk_simulation_wrench @layout(56, 8) {
		struct_size: u32 @offset(0) @struct_size;
		force: array<f64, 3> @offset(8);
		torque: array<f64, 3> @offset(32);
	}
	handle rk_robot_contact_list : u32 @destroy("rk_robot_contact_list_destroy");
	/**
	 * Opaque handle for one shared simulation universe and clock.
	 */
	handle rk_simulation : u32 @destroy("rk_simulation_destroy");
	/**
	 * Kinds of primitive link collision shape. Sizes are in metres.
	 */
	type rk_simulation_link_shape_type = u32;
	/**
	 * Immutable copied presentation snapshot captured under one simulation lock.
	 */
	handle rk_simulation_presentation : u32 @destroy("rk_simulation_presentation_destroy");
}
