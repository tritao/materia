{
  "version": 1,
  "package": {
    "name": "robotkit-sim"
  },
  "sourceRoots": [
    "haxe"
  ],
  "scopeSourceRoots": false,
  "dependencies": {
    "robotkit-core": {
      "path": "../core"
    },
    "robotkit-autonomy": {
      "path": "../autonomy"
    },
    "simkit": {
      "path": "../../simkit"
    }
  },
  "target": "host",
  "ffi": {
    "interfaces": [
      "../runtime/bindings/robotkit-simkit.hxi"
    ],
    "projections": [
      "../runtime/bindings/robotkit-simkit.hxmap"
    ]
  }
}
