{
	"version": 1,
	"package": { "name": "cadbridge-tests" },
	"entry": "tests.CadBridgeTests",
	"sourceRoots": ["src", "../../../machinekit/examples", "../../../machinekit/examples/mobile-base", "../../../machinekit/examples/robot-arm"],
	"dependencies": {
		"nativekit": { "path": "../../../nativekit" },
		"projectkit": { "path": "../../../projectkit" },
		"robotkit": { "path": "../.." },
		"cadkit": { "path": "../../../cadkit" },
		"machinekit": { "path": "../../../machinekit" },
		"bimkit": { "path": "../../../bimkit" },
		"cadbridge": { "path": ".." }
	},
	"native": {
		"cmake": {
			"source": "../../robotd/native",
			"target": "robotd_native",
			"inputs": [
				"../../robotd/native/CMakeLists.txt",
				"../../CMakeLists.txt",
				"../../runtime/CMakeLists.txt",
				"../../runtime/include/robotkit_runtime.h",
				"../../runtime/include/robotkit_simkit.h",
				"../../../trajectorykit/native/src/trajectory.cpp",
				"../../../trajectorykit/native/src/validation.cpp",
				"../../../trajectorykit/native/CMakeLists.txt",
				"../../../trajectorykit/native/include/trajectory_core.h",
				"../../../trajectorykit/native/include/trajectory_core.hpp",
				"../../../nativekit/CMakeLists.txt",
				"../../../simkit/CMakeLists.txt",
				"../../inference/CMakeLists.txt",
				"../../inference/src/inference.cpp",
				"../../inference/include/robotkit_inference.h",
				"../../policy/CMakeLists.txt",
				"../../policy/src/policy.cpp",
				"../../policy/include/robotkit_policy.h"
			]
		}
	},
	"target": "host",
	"outputDir": "build"
}
