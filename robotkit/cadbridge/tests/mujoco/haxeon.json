{
  "version": 1,
  "package": {"name": "cadbridge-mujoco-tests"},
  "entry": "tests.EndEffectorContactMuJoCo",
  "sourceRoots": ["src", "../../../../machinekit/examples"],
  "dependencies": {
    "haxeon-platform": {"path": "../../../../haxeon/packages/platform"},
    "robotkit": {"path": "../../.."},
    "cadkit": {"path": "../../../../cadkit"},
    "machinekit": {"path": "../../../../machinekit"},
    "cadbridge": {"path": "../.."}
  },
  "native": {
    "cmake": {
      "source": "../../../robotd/native-mujoco",
      "target": "robotd_native",
      "libraries": ["nativekit", "nativekit_scene", "nativekit_sim_core", "trajectory_core", "robotkit_runtime", "robotkit_inference", "nativekit_sim_mujoco", "robotkit_policy"],
      "inputs": [
        "../../../runtime/include/robotkit_runtime.h",
        "../../../runtime/include/robotkit_simkit.h",
        "../../../../simkit/CMakeLists.txt",
        "../../../../cadkit/CMakeLists.txt",
        "../../../inference/CMakeLists.txt",
        "../../../inference/src/inference.cpp",
        "../../../inference/include/robotkit_inference.h",
        "../../../policy/CMakeLists.txt",
        "../../../policy/src/policy.cpp",
        "../../../policy/include/robotkit_policy.h"
      ]
    }
  },
  "target": "host",
  "outputDir": "build"
}
