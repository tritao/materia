// Serves the built site (dist/) as a Worker with static assets. Cloudflare Workers Builds runs
// `npm run build` then `npx wrangler deploy` from this directory on every push to main.
{
	"name": "materia-docs",
	"compatibility_date": "2026-10-06",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	}
}
