---
// Starlight's Markdown wrapper, plus figure and diagram styles and the script that renders `<figure data-figure>`
// elements from computed data and the live widgets (`<figure data-widget>`).
import Default from "@astrojs/starlight/components/MarkdownContent.astro";
import "../styles/figures.css";
import "../styles/diagrams.css";
---

<Default><slot /></Default>

<script>
	import { keepDiagramsReadable, linkEditorExamples, renderFigures } from "../scripts/figures";
	import { renderWidgets } from "../scripts/widgets";
	renderFigures();
	renderWidgets();
	// The component catalogue: search and family filters, and the 3D viewer only on pages that show models.
	import { filterComponents } from "../scripts/catalogue";
	filterComponents();
	if (document.querySelector("model-viewer")) import("@google/model-viewer");
	keepDiagramsReadable();
	linkEditorExamples();
</script>
