     "name": "PrinterFlavour",
     "kind": "enum",
     "file": "cnckit/haxe/cnckit/printer/PrinterFlavour.hx",
     "doc": "The firmware dialect `PrinterWriter` writes. They differ only in object markers and non-standard heaters and fans.",
     "fields": [
      {
       "name": "Klipper",
       "kind": "case",
       "signature": "",
       "doc": "Klipper: `EXCLUDE_OBJECT_*` markers, `SET_HEATER_TEMPERATURE` and `SET_FAN_SPEED` for generic parts."
      },
      {
       "name": "Marlin",
       "kind": "case",
       "signature": "",
       "doc": "Marlin: `M486` object markers; only the hotend, bed, chamber and numbered fans exist."
      }
     ]
    },
    {
     "name": "PrinterInterpreter",
     "kind": "class",
     "file": "cnckit/haxe/cnckit/printer/PrinterInterpreter.hx",
     "doc": "Interprets Marlin, Klipper and RepRap G-code into the shared toolpath format.\n\n`E` is filament, not a coordinate: a move that pushes filament lays a bead whose cross-section is\nthe filament pushed times its area over the distance moved, and the program says that (`Deposit`),\nnot how far the extruder turned. A new `Deposit` starts when that ratio changes by more than the\ncontroller's tolerance, so the deposited volume is right to that tolerance. Overrides `M220` and\n`M221` are folded into the moves they scale, as the firmware does. Slicers' comments are read as\nlayer, feature and object markers.",
     "fields": [
      {
       "name": "controller",
       "kind": "var",
       "signature": ":CncController",
       "final": true
      },
      {
       "name": "start",
       "kind": "var",
       "signature": ":Point3",
       "final": true
      },
      {
       "name": "ops",
       "kind": "var",
       "signature": ":Array<ToolpathOp>"
      },
      {
       "name": "diagnostics",
       "kind": "var",
       "signature": ":Array<CncDiagnostic>"
      },
      {
       "name": "homes",
       "kind": "var",
       "signature": ":Bool",
       "doc": "Did the program ask to home?"
      },
      {
       "name": "new",
       "kind": "method",
       "signature": "(controller:CncController, start:Point3):Void"
      },
      {
       "name": "interpret",
       "kind": "method",
       "signature": "(blocks:Array<CncBlock>):Array<ToolpathOp>"
      },
      {
       "name": "feature",
       "kind": "method",
       "signature": "(label:String):PrintFeature",
       "static": true,
       "doc": "The label slicers give a feature, as the shared vocabulary."
      }
     ]
    },
    {
     "name": "PrinterWriter",
     "kind": "class",
     "file": "cnckit/haxe/cnckit/printer/PrinterWriter.hx",
     "doc": "The printer post: writes a program's printing operations as Marlin or Klipper G-code, in\nmillimetres with relative extrusion (`M83`). Each bead's `E` is its cross-section times the\ndistance over the filament's area, so reading the file back (`CncCompiler` with a printer\ncontroller) recovers the deposited volume. Layers and features are written as the slicers'\ncomments, so other tools and this reader see the same markers.",
     "fields": [
      {
       "name": "write",
       "kind": "method",
       "signature": "(program:ToolpathProgram, controller:CncController, ?flavour:PrinterFlavour, ?home:Bool):String",
       "static": true,
       "doc": "`home` writes a leading `G28`: the printer homes before the program."
      },
      {
       "name": "featureLabel",
       "kind": "method",
       "signature": "(kind:PrintFeature):String",
       "static": true,
       "doc": "The label slicers use, which `PrinterInterpreter.feature` reads back."
      }
     ]
    }
