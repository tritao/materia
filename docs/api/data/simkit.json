    {
     "name": "SimSession",
     "kind": "class",
     "file": "simkit/sim_core/bindings/haxe/nativekit/sim/SimSession.hx",
     "doc": "One shared simulated space around a borrowed world and scene: the fixed\nclock, stepping, realtime ticking, and the objects and actors every\nparticipant shares. Dispose it before the world and scene.",
     "fields": [
      {
       "name": "new",
       "kind": "method",
       "signature": "(scene:Scene, world:nksim_world):Void"
      },
      {
       "name": "nativeHandle",
       "kind": "method",
       "signature": "():nksim_session"
      },
      {
       "name": "step",
       "kind": "method",
       "signature": "(?ownerTimeNs:haxe.Int64):Float",
       "doc": "Advances exactly one fixed tick and returns the new simulation time."
      },
      {
       "name": "dueTicks",
       "kind": "method",
       "signature": "(elapsedNs:haxe.Int64, maxTicks:Int):Int",
       "doc": "Owner-paced realtime: adds `elapsedNs` of wall time and returns how many\nfixed ticks are due, at most `maxTicks` (the excess is dropped, so a slow\nowner slows simulation time). Run each with `stepPaced`, acting on the\nsession between them."
      },
      {
       "name": "stepPaced",
       "kind": "method",
       "signature": "():Float",
       "doc": "Like `step`, but participants see a realtime tick on the native monotonic clock."
      },
      {
       "name": "addStepObserver",
       "kind": "method",
       "signature": "(callback:() -> Void):Int",
       "doc": "Runs after each successful explicit step, once the shared contacts are available."
      },
      {
       "name": "removeStepObserver",
       "kind": "method",
       "signature": "(id:Int):Void"
      },
      {
       "name": "start",
       "kind": "method",
       "signature": "():Void"
      },
      {
       "name": "stop",
       "kind": "method",
       "signature": "():Void"
      },
      {
       "name": "reset",
       "kind": "method",
       "signature": "():Void"
      },
      {
       "name": "addResetObserver",
       "kind": "method",
       "signature": "(callback:() -> Void):Int",
       "doc": "Runs after a successful reset. Clock owners invalidate the preceding observation epoch."
      },
      {
       "name": "removeResetObserver",
       "kind": "method",
       "signature": "(id:Int):Void"
      },
      {
       "name": "isRunning",
       "kind": "method",
       "signature": "():Bool"
      },
      {
       "name": "isSealed",
       "kind": "method",
       "signature": "():Bool"
      },
      {
       "name": "stepIndex",
       "kind": "method",
       "signature": "():haxe.Int64"
      },
      {
       "name": "simulationTime",
       "kind": "method",
       "signature": "():Float"
      },
      {
