      },
      {
       "name": "createFixedJoint",
       "kind": "method",
       "signature": "(parent:SimObject, child:SimObject):SimFixedJoint",
       "doc": "Rigidly connect objects using their creation frames; the parent retains its motion."
      },
      {
       "name": "createMeasuredFixedJoint",
       "kind": "method",
       "signature": "(parent:SimObject, child:SimObject):SimFixedJoint",
       "doc": "Fasten at the current measured pose while stopped, retaining physical mass and motion.\nThe session removes this runtime connection on reset."
