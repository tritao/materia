      {
       "name": "rakeFaceRegion",
       "kind": "method",
       "signature": "(gash:Int, ?thread:Int, ?turn:Int):Array<Point3>",
       "doc": "One closed rake-face tooth region. thread=0..starts-1, turn is any axial turn\nof that thread. Consecutive thread starts are one axial pitch apart."
      },
      {
       "name": "relievedFaceRegion",
       "kind": "method",
       "signature": "(gash:Int, thread:Int, turn:Int, behind:Float, tipRelief:Float):Array<Point3>",
