    {
     "name": "CamPocketPlanner",
     "kind": "class",
     "file": "camkit/haxe/camkit/CamPocketPlanner.hx",
     "doc": "Horizontal cutter-centre passes inside a face eroded by a disk.",
     "fields": [
      {
       "name": "plan",
       "kind": "method",
       "signature": "(contour:CamContour, radius:Float, stepOver:Float, ?islands:Array<CamContour>):Array<CamPocketPass>",
       "static": true
      },
      {
       "name": "fill",
       "kind": "method",
       "signature": "(contour:CamContour, spacing:Float, ?islands:Array<CamContour>):Array<CamPocketPass>",
       "static": true,
       "doc": "Horizontal passes across a face, one on every line `y = k * spacing` of a lattice through the origin\nthat crosses it: the face's own interior, with no cutter eroding the edges. Because the lattice does\nnot depend on the face, passes of neighbouring layers line up. The islands are holes."
      },
      {
       "name": "canLink",
       "kind": "method",
       "signature": "(contour:CamContour, islands:Array<CamContour>, radius:Float, a:Point3, b:Point3):Bool",
       "static": true,
       "doc": "Exact segment/edge clearance proof for a local link above a cleared layer."
      }
     ]
    },
    {
     "name": "CamSheetProfiles",
