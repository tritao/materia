{
 "kit": "camkit",
 "packages": [
  {
   "name": "camkit",
   "types": [
    {
     "name": "CamContour",
     "kind": "class",
     "file": "camkit/haxe/camkit/CamContour.hx",
     "doc": "One simple closed XY boundary, in machine metres.",
     "fields": [
      {
       "name": "exactBoundary",
       "kind": "var",
       "signature": ":Null<Array<cadkit.sheetmetal.Segment>>",
       "doc": "Optional exact CAD boundary in metres. Vertices remain the declared chordal representation."
      },
      {
       "name": "chordTolerance",
       "kind": "var",
       "signature": ":Float"
      },
      {
       "name": "vertices",
       "kind": "var",
       "signature": ":Array<Point3>",
       "final": true
      },
      {
       "name": "z",
       "kind": "var",
       "signature": ":Float",
       "final": true
      },
      {
       "name": "signedArea",
       "kind": "var",
       "signature": ":Float",
       "final": true
      },
      {
       "name": "new",
       "kind": "method",
       "signature": "(vertices:Array<Point3>, ?validated:Bool):Void",
       "doc": "`validated` skips the self-intersection check, which costs the square of the vertex count: for\ncontours that come from a valid B-rep face, where a boundary cannot cross itself."
      },
      {
       "name": "fromSketch",
       "kind": "method",
       "signature": "(authored:ConstrainedSketch, solved:SolvedSketch):CamContour",
       "static": true,
       "doc": "Builds a single profile from solved cadkit lines, arcs, or one circle."
      },
      {
       "name": "fromEdges",
       "kind": "method",
       "signature": "(edges:Array<Edge>, ?unit:String, ?chordToleranceMetres:Float):CamContour",
       "static": true,
       "doc": "CAD edge positions are sampled adaptively to the requested chord tolerance."
      },
      {
       "name": "fromFace",
       "kind": "method",
       "signature": "(face:Face, ?unit:String, ?chordToleranceMetres:Float):CamContour",
       "static": true
      },
      {
       "name": "fromFaceBoundaries",
       "kind": "method",
       "signature": "(face:Face, ?unit:String, ?chordToleranceMetres:Float):Array<CamContour>",
       "static": true,
       "doc": "Returns the outer face contour first, followed by its inner boundaries."
      },
      {
       "name": "inset",
       "kind": "method",
       "signature": "(distance:Float):CamContour",
       "doc": "Positive inset moves toward the polygon interior; negative moves outward."
      }
     ]
    },
    {
     "name": "CamCutDirection",
     "kind": "abstract",
     "file": "camkit/haxe/camkit/CamCutDirection.hx",
     "underlying": "String",
     "doc": "Relative to a clockwise spindle. Outside climb is CW; inside climb is CCW.",
     "fields": [
      {
       "name": "Climb",
       "kind": "var",
       "signature": ":String",
       "static": true
      },
      {
       "name": "Conventional",
       "kind": "var",
       "signature": ":String",
       "static": true
      }
     ]
    },
    {
     "name": "CamExactBoundary",
     "kind": "class",
     "file": "camkit/haxe/camkit/CamExactBoundary.hx",
     "doc": "Exact compensation belongs to CamKit. Native geometry uses mm for its tolerance.\nThe final centreline is sampled to the declared chord tolerance, in metres.",
     "fields": [
      {
       "name": "reliefCenters",
       "kind": "method",
       "signature": "(contour:CamContour, radius:Float, outside:Bool):Array<Point3>",
       "static": true,
       "doc": "Matched-radius relief centres may be isolated points discarded by regular offsets.\nSupply separate vertical entries within the SAME operation/provenance, after\nproving that the complete cutter disc fits the source's removable region."
      },
      {
       "name": "offset",
       "kind": "method",
       "signature": "(contour:CamContour, radius:Float, depth:Float, outside:Bool):Array<PathGeometry>",
       "static": true
      }
     ]
    },
    {
     "name": "CamJob",
     "kind": "class",
     "file": "camkit/haxe/camkit/CamJob.hx",
     "doc": "2.5D toolpath producer. All inputs here are metres and metres/second.",
     "fields": [
      {
       "name": "safeZ",
       "kind": "var",
       "signature": ":Float",
       "final": true
      },
      {
       "name": "spindleRpm",
       "kind": "var",
       "signature": ":Float",
       "final": true
      },
      {
       "name": "blendTolerance",
       "kind": "var",
       "signature": ":Float",
       "final": true,
       "doc": "How far a cutting move may round the corner into the next one (G64 P),\nin metres; zero stops exactly at every corner. Plunges and ramps always\nstop exactly."
      },
      {
       "name": "arcTolerance",
       "kind": "var",
       "signature": ":Float",
       "final": true,
       "doc": "How far an arc may stray from the cutting lines it replaces, in metres:\na circle that the contours polygonized is cut as G2/G3 again (see\n`ArcFitting`). Zero keeps every line."
      },
      {
       "name": "new",
       "kind": "method",
       "signature": "(safeZ:Float, spindleRpm:Float, ?initial:Point3, ?blendTolerance:Float, ?arcTolerance:Float, ?spindleSpinUpSeconds:Float, ?initialRetract:Bool, ?cutDirection:CamCutDirection, ?approachClearance:Float):Void",
       "doc": "`safeZ` is the lowest height for rapid traverses over the work. `initial`\nis where the spindle starts, before any tool length applies; it must be\nclear of the work, since the first tool is loaded there."
      },
      {
       "name": "profile",
       "kind": "method",
       "signature": "(contour:CamContour, tool:Tool, depth:Float, feed:Float, ?side:String, ?stepDown:Float, ?plungeFeed:Null<Float>, ?featureRef:String, ?startDepth:Float):CamJob",
       "doc": "Offset closed profile; `outside` and `inside` use the cutter radius."
      },
      {
       "name": "profileFace",
       "kind": "method",
       "signature": "(face:Face, tool:Tool, depth:Float, feed:Float, ?stepDown:Float, ?unit:String, ?chordToleranceMetres:Float, ?plungeFeed:Null<Float>):CamJob",
       "doc": "Profile a planar CAD face, completing each hole before releasing its outer edge."
      },
      {
       "name": "pocket",
       "kind": "method",
       "signature": "(contour:CamContour, tool:Tool, depth:Float, feed:Float, stepOver:Float, ?stepDown:Float, ?plungeFeed:Null<Float>, ?featureRef:String):CamJob",
       "doc": "Clear a pocket with a separate plunge feed and ramps where spans allow."
      },
      {
       "name": "pocketFace",
       "kind": "method",
       "signature": "(face:Face, tool:Tool, depth:Float, feed:Float, stepOver:Float, ?stepDown:Float, ?unit:String, ?chordToleranceMetres:Float, ?plungeFeed:Null<Float>):CamJob",
       "doc": "Clear a face around its internal islands, then finish every boundary."
      },
      {
       "name": "drill",
       "kind": "method",
       "signature": "(holes:Array<Point3>, tool:Tool, depth:Float, retractZ:Float, feed:Float, ?featureRef:String, ?peckDepth:Float):CamJob",
       "doc": "Expand hole centres into safe rapid, feed, and retract moves."
      },
      {
       "name": "finish",
       "kind": "method",
       "signature": "(?setup:Setup):ToolpathProgram"
      }
     ]
    },
    {
     "name": "CamPocketPass",
     "kind": "typedef",
     "file": "camkit/haxe/camkit/CamPocketPlanner.hx",
     "fields": [
      {
       "name": "y",
       "kind": "var",
