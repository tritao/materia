{
  "version": 1,
  "package": {
    "name": "processkit-moonraker-tests"
  },
  "entry": "MoonrakerTests",
  "sourceRoots": [
    "."
  ],
  "dependencies": {
    "collisionkit-native": {
      "path": "../../../collisionkit/native"
    },
    "processkit": {
      "path": "../.."
    }
  },
  "target": "host",
  "outputDir": "build",
  "native": {
    "cmake": {
      "source": "native",
      "target": "moonraker_native",
      "libraries": [
        "nativekit"
      ],
      "inputs": [
        "native/CMakeLists.txt",
        "../../../haxeon/vendor/nativekit/CMakeLists.txt",
        "../../../haxeon/vendor/nativekit/include/nativekit_transport.h",
        "../../../haxeon/vendor/nativekit/src/transport/transport.cpp",
        "../../../haxeon/vendor/nativekit/src/transport/transport_web.cpp"
      ]
    }
  }
}
