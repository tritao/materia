package nativekit.ui.icons;

/** Typed names for vector icons embedded in NativeKit UI. */
enum abstract IconName(Int) from Int to Int {
	var Search = 0;
	var Close = 1;
	var Sun = 2;
	var Moon = 3;
	var Inspect = 4;
	var ChevronDown = 5;
	var ChevronRight = 6;
	var Plus = 7;
	var Copy = 8;
	var Trash = 9;
	var NewFile = 10;
	var FolderOpen = 11;
	var Save = 12;
	var Undo = 13;
	var Redo = 14;
}
