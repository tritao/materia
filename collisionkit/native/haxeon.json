{
	"version": 1,
	"package": { "name": "collisionkit-native" },
	"sourceRoots": ["haxe"],
	"scopeSourceRoots": false,
	"dependencies": {
		"collisionkit": { "path": ".." }
	},
	"ffi": {
		"interfaces": ["bindings/collisionkit.hxi"]
	},
	"native": {
		"cmake": {
			"source": ".",
			"target": "collisionkit_core",
			"library": "collisionkit_core",
			"inputs": [
				"CMakeLists.txt",
				"include/collisionkit.h",
				"src/api.cpp",
				"src/world.cpp",
				"src/world.hpp",
				"src/handles.hpp",
				"vendor/coal/materia/CMakeLists.txt"
			]
		}
	},
	"target": "host"
}
