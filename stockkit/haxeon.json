{
  "version": 1,
  "package": { "name": "stockkit" },
  "sourceRoots": ["haxe"],
  "scopeSourceRoots": false,
  "dependencies": {
    "gearkit": { "path": "../gearkit" },
    "cadkit": { "path": "../cadkit" },
    "toolpathkit": { "path": "../toolpathkit" }
  },
  "ffi": {
    "interfaces": ["native/bindings/stockkit.hxi"]
  },
  "native": {
    "cmake": {
      "source": "native",
      "target": "stockkit_core",
      "library": "stockkit_core",
      "inputs": [
        "native/CMakeLists.txt",
        "native/include/stockkit.h",
        "native/src/api.cpp",
        "native/src/api_internal.hpp",
        "native/src/ring/api_ring.cpp",
        "native/src/ring/rake.cpp",
        "native/src/ring/rake.hpp",
        "native/src/ring/ring.cpp",
        "native/src/ring/ring.hpp",
        "native/src/contour.cpp",
        "native/src/contour.hpp",
        "native/src/mesh.cpp",
        "native/src/mesh.hpp",
        "native/src/pool.cpp",
        "native/src/pool.hpp",
        "native/src/preview.cpp",
        "native/src/preview.hpp",
        "native/src/profile.cpp",
        "native/src/profile.hpp",
        "native/src/stock.cpp",
        "native/src/stock.hpp",
        "native/src/sweep.cpp",
        "native/src/sweep.hpp",
        "native/src/tool.cpp",
        "native/src/tool.hpp"
      ]
    }
  },
  "target": "host"
}
