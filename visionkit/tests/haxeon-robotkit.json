{
  "version": 1,
  "package": {
    "name": "visionkit-robotkit-tests"
  },
  "entry": "tests.VisionKitRobotKitTests",
  "sourceRoots": [
    "robotkit-src"
  ],
  "dependencies": {
    "visionkit": {
      "path": ".."
    },
    "robotkit": {
      "path": "../../robotkit"
    },
    "robotkit-inference": {
      "path": "../../robotkit/inference"
    }
  },
  "native": {
    "cmake": {
      "source": "../native",
      "target": "visionkit_core",
      "inputs": [
        "../native/CMakeLists.txt",
        "../native/include/visionkit.h",
        "../native/src/visionkit.cpp",
        "../native/src/fiducial.cpp",
        "../native/src/calibration.cpp"
      ]
    }
  },
  "target": "host",
  "outputDir": "build-robotkit"
}
