{
  "version": 1,
  "package": { "name": "visionkit-robotkit-tests" },
  "entry": "tests.VisionKitRobotKitTests",
  "sourceRoots": ["robotkit-src"],
  "dependencies": {
    "visionkit": { "path": ".." },
    "robotkit": { "path": "../../robotkit" }
  },
  "native": {
    "cmake": {
      "source": "../native",
      "target": "visionkit_core",
      "inputs": ["../native/CMakeLists.txt", "../native/include/visionkit.h",
        "../native/src/visionkit.cpp", "../native/src/fiducial.cpp"]
    }
  },
  "target": "host",
  "outputDir": "build-robotkit"
}
