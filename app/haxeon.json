		"machinekit": { "path": "../machinekit" },
		"bimkit": { "path": "../bimkit" },
		"uikit": { "path": "../uikit" },
		"robotkit": { "path": "../robotkit" },
		"cadbridge": { "path": "../robotkit/cadbridge" },
		"scenekit": { "path": "../scenekit" },
		"animkit": { "path": "../animkit" }
