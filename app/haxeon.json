{
	"version": 1,
	"package": { "name": "app" },
	"entry": "app.Main",
	"sourceRoots": ["src"],
	"dependencies": {
		"nativekit": { "path": "../nativekit" },
		"cadkit": { "path": "../cadkit" },
		"bimkit": { "path": "../bimkit" },
		"uikit": { "path": "../uikit" },
		"robotkit": { "path": "../robotkit" },
		"scenekit": { "path": "../scenekit" }
	},
	"native": {
		"cmake": {
			"source": "native",
			"target": "haxeon_app_native",
			"inputs": ["native/CMakeLists.txt", "../cadkit/CMakeLists.txt", "../cadkit/core/CMakeLists.txt", "../robotkit/CMakeLists.txt", "../robotkit/runtime/CMakeLists.txt"]
		}
	},
	"target": "host",
	"outputDir": "build"
}
