--- /dev/null
+++ b/gdk/pacing-debug.h
@@ -0,0 +1,10 @@
+#include <stdio.h>
+#include <glib.h>
+static void pacing_trace(const char *event, const void *clock, gint64 a, gint64 b, gint64 c)
+{
+ static FILE *f; static int checked;
+ if (!checked) { const char *base=g_getenv("NK_GTK_TRACE"); checked=1;
+  if(base) { char *path=g_strdup_printf("%s-%s.csv",base,PACING_TAG); f=fopen(path,"w"); g_free(path); if(f)setvbuf(f,NULL,_IOFBF,1024*1024); }
+ }
+ if(f)fprintf(f,"%" G_GINT64_FORMAT ",%s,%p,%" G_GINT64_FORMAT ",%" G_GINT64_FORMAT ",%" G_GINT64_FORMAT "\n",g_get_monotonic_time(),event,clock,a,b,c);
+}
