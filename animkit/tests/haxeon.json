{
  "version": 1,
  "package": { "name": "animkit-tests" },
  "entry": "AnimKitTests",
  "sourceRoots": ["src"],
  "dependencies": {
    "animkit": { "path": ".." },
    "scenekit": { "path": "../../scenekit" },
    "haxeon-platform": { "path": "../../haxeon/packages/platform" }
  },
  "native": {
    "cmake": {
      "source": "native",
      "target": "animkit_tests_native",
      "libraries": ["nativekit", "nativekit_gpu", "nativekit_scene", "nativekit_scene_render", "animkit_core"],
      "inputs": [
        "native/CMakeLists.txt",
        "../../haxeon/packages/animation/native/CMakeLists.txt",
        "../../haxeon/packages/animation/native/include/animkit.h",
        "../../haxeon/packages/animation/native/src/api.cpp",
        "../../haxeon/packages/animation/native/src/import.cpp",
        "../../haxeon/packages/animation/native/src/runtime.cpp",
        "../../scenekit/scene/CMakeLists.txt",
        "../../haxeon/vendor/nativekit/CMakeLists.txt"
      ]
    }
  },
  "target": "host",
  "outputDir": "build"
}
