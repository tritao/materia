import cnckit.CncCompiler;
import cnckit.CncController;
import cnckit.CncDialect;
import cnckit.CncDiagnostic;
import cnckit.PrinterSettings;
import cnckit.CncWriter;
import cnckit.printer.PrinterFlavour;
import cnckit.printer.PrinterWriter;
import toolpathkit.path.GeometryTools;
import toolpathkit.path.PathGeometry;
import toolpathkit.path.Point3;
import toolpathkit.path.PrintFeature;
import toolpathkit.path.Provenance;
import toolpathkit.path.ToolpathOp;
import toolpathkit.path.ToolpathProgram;
import toolpathkit.setup.Setup;
import toolpathkit.tool.ToolLibrary;

/** The printer dialect: slicer files read into the IR, the IR written back, and both round trips. */
class PrinterGcodeTests {
  static var assertions = 0;

  static function check(ok:Bool, message:String):Void {
    assertions++;
    if (!ok) throw message;
  }

  static function near(actual:Float, expected:Float, message:String, ?tolerance:Float = 1e-9):Void
    check(Math.abs(actual - expected) <= tolerance, '$message: expected $expected, got $actual');

  static function relative(actual:Float, expected:Float, message:String, tolerance:Float):Void
    check(Math.abs(actual - expected) <= tolerance * Math.abs(expected), '$message: expected $expected, got $actual');

  static function controller(?settings:PrinterSettings):CncController
    return new CncController(Printer, null, settings);

  static function compile(source:String, ?settings:PrinterSettings):cnckit.CncCompileResult
    return CncCompiler.compileDetailed(source, controller(settings));

  static function errors(result:cnckit.CncCompileResult):Array<CncDiagnostic>
    return [for (item in result.diagnostics) if (item.severity == Error) item];

  static function warnings(result:cnckit.CncCompileResult, code:String):Int {
    var count = 0;
    for (item in result.diagnostics) if (item.severity == Warning && item.code == code) count++;
    return count;
  }

  static function tag(op:ToolpathOp):String
    return switch op {
      case Heat(heater, celsius, wait, _): 'heat $heater ${celsius}${wait ? " wait" : ""}';
      case Fan(fan, duty, _): 'fan $fan ${Math.round(duty * 255)}';
      case Layer(index, _, _): 'layer $index';
      case Feature(kind, _): 'feature ' + PrinterWriter.featureLabel(kind);
      case PrintObject(name, start, _): 'object $name ${start ? "start" : "end"}';
      case Deposit(_, _, _, _): "deposit";
      case DepositOff(_): "depositOff";
      case FilamentMove(length, _, _): 'filament ${Math.round(length * 1e6)}';
      case Move(kind, geometry, _, _, _): 'move $kind ${switch geometry { case Line(_, _): "line"; case _: "arc"; }}';
      case Dwell(_, _): "dwell";
      case End(_): "end";
      case ProgramStop(_): "stop";
      case OptionalStop(_): "optional stop";
      case _: "other";
    };

  static function tags(ops:Array<ToolpathOp>):Array<String> return [for (op in ops) tag(op)];

  static function endOf(op:ToolpathOp):Null<Point3>
    return switch op {
      case Move(_, geometry, _, _, _): GeometryTools.pointAt(geometry, GeometryTools.length(geometry));
      case _: null;
    };

  static function layersOf(ops:Array<ToolpathOp>):Array<{index:Int, z:Float}> {
    var result = [];
    for (op in ops) switch op {
      case Layer(index, z, _): result.push({index: index, z: z});
      case _:
    }
    return result;
  }

  static function featuresOf(ops:Array<ToolpathOp>):Array<String> {
    var result = [];
    for (op in ops) switch op {
      case Feature(kind, _): result.push(PrinterWriter.featureLabel(kind));
      case _:
    }
    return result;
  }

  static function filamentOf(ops:Array<ToolpathOp>):Array<{length:Float, speed:Float}> {
    var result = [];
    for (op in ops) switch op {
      case FilamentMove(length, speed, _): result.push({length: length, speed: speed});
      case _:
    }
    return result;
  }

  /** The bead areas of the deposits, in mm^2. */
  static function beadAreas(ops:Array<ToolpathOp>):Array<Float> {
    var result:Array<Float> = [];
    for (op in ops) switch op {
      case Deposit(area, _, _, _): result.push(area * 1e6);
      case _:
    }
    return result;
  }

  public static function run():Int {
    assertions = 0;
    prusa();
    cura();
    orca();
    firmware();
    refused();
    roundTrips();
    return assertions;
  }

  static function prusa():Void {
    // A PrusaSlicer-style file: relative E, LAYER_CHANGE/Z/HEIGHT comments, TYPE features, firmware retracts.
    var result = compile("; generated by PrusaSlicer 2.7\nM83\nM104 S210 T0\nM140 S60\nG28\nM190 S60\nM109 S210\nM106 S127\n" +
      "G1 Z.2 F720\nG1 X10 Y10 F7200\n;LAYER_CHANGE\n;Z:0.2\n;HEIGHT:0.2\n;TYPE:External perimeter\n" +
      "G1 X20 Y10 E.37 F1800\nG1 X20 Y20 E.37\n;TYPE:Internal infill\nG1 X10 Y20 E.37\n" +
      "G1 E-.8 F2100\nG1 Z.6 F720\nG1 X5 Y5 F7200\nG1 Z.2\nG1 E.8 F1500\n;LAYER_CHANGE\n;Z:0.4\n;HEIGHT:0.2\n;TYPE:Perimeter\n" +
      "G1 Z.4\nG1 X15 Y5 E.37 F1800\nM107\nM104 S0\nM140 S0\nM84\n");
    check(errors(result).length == 0, "a PrusaSlicer file has no errors: " + errors(result));
    check(result.homes, "G28 asks the player to home");
    var ops = result.program.ops;
    check(tags(ops).slice(0, 5).join("|") == "heat hotend 210|heat bed 60|heat bed 60 wait|heat hotend 210 wait|fan part 127",
      "temperatures and the fan come first, in order: " + tags(ops).slice(0, 8));
    var layers = layersOf(ops);
    check(layers.length == 2 && layers[0].index == 0 && layers[1].index == 1, "two layers");
    near(layers[0].z, 0.0002, "the first layer's height from ;Z:", 1e-12);
    near(layers[1].z, 0.0004, "the second layer's height from ;Z:", 1e-12);
    var features = featuresOf(ops);
    check(features.join(",") == "External perimeter,Internal infill,Perimeter", "feature comments become markers: " + features);
    // 0.37 mm of 1.75 mm filament over 10 mm.
    var area = Math.PI * 1.75 * 1.75 / 4.0 * 0.37 / 10.0;
    var areas = beadAreas(ops);
    check(areas.length >= 2, "beads are deposited");
    relative(areas[0], area, "the bead's cross-section from E", 1e-9);
    // Two equal moves share one Deposit: the third (the same ratio) adds none.
    var moves = 0, deposits = 0;
    for (op in ops) switch op {
      case Deposit(_, _, _, _): deposits++;
      case Move(Cut, _, _, _, _): moves++;
      case _:
    }
    check(moves == 4 && deposits == 2, 'four cutting moves under two deposits (layer one is deposited, retract ends it): $moves, $deposits');
    // Retract and unretract are filament moves; the layer-change travel deposits nothing.
    var filament = filamentOf(ops);
    check(filament.length == 2, "retract and unretract");
    near(filament[0].length, -0.0008, "retract by .8 mm", 1e-12);
    near(filament[0].speed, 0.035, "at 2100 mm/min", 1e-12);
    near(filament[1].length, 0.0008, "unretract by .8 mm", 1e-12);
    // The bead is as tall as the layer and as wide as its area allows.
    for (op in ops) switch op {
      case Deposit(bead, width, height, _):
        near(height, 0.0002, "the bead is a layer tall", 1e-12);
        check(width * height >= bead && width > height, "and wider than tall");
      case _:
    }
    check(warnings(result, "CNC_PRINTER_IGNORED") == 0, "M84 is not worth a warning");
  }

  static function cura():Void {
    var result = compile(";FLAVOR:Marlin\n;TIME:100\nM82 ;absolute extrusion mode\nM104 S200\nM109 S200\nG92 E0\nG0 F3600 X10 Y10 Z0.3\n" +
      ";LAYER_COUNT:2\n;LAYER:0\n;TYPE:WALL-OUTER\n;MESH:cube.stl\nG1 F1800 X20 Y10 E0.37\nG1 X20 Y20 E0.74\n;TYPE:SKIN\n" +
      "G1 F2100 E-0.06\nG0 F3600 X5 Y5 Z0.6\nG1 F2100 E0.74\n;LAYER:1\n;TYPE:FILL\nG1 F1800 X15 Y5 E1.11\nM140 S0\nM2\n");
    check(errors(result).length == 0, "a Cura file has no errors: " + errors(result));
    check(tags(result.program.ops).join("|").indexOf("layer 0") >= 0 && tags(result.program.ops).join("|").indexOf("layer 1") >= 0,
      "Cura layer numbers are kept");
    var features = featuresOf(result.program.ops);
    check(features.join(",") == "External perimeter,Solid infill,Internal infill", "Cura feature names map: " + features);
    var objects = [];
    for (op in result.program.ops) switch op {
      case PrintObject(name, true, _): objects.push(name);
      case _:
    }
    check(objects.join(",") == "cube.stl", ";MESH: starts an object");
    // Absolute E: the 0.37 steps are deltas, the retract and the re-prime a filament move each.
    var filament = [for (item in filamentOf(result.program.ops)) Math.round(item.length * 1e6)];
    check(filament.join(",") == "-800,800", "absolute E: 0.74 to -0.06 retracts .8 mm, back to 0.74 primes it: " + filament);
    // The layer's height is the first move's Z when only ;LAYER: says it is a layer.
    var layerZ = [for (item in layersOf(result.program.ops)) item.z];
    near(layerZ[0], 0.0003, "layer 0 sits where the first move put the nozzle", 1e-12);
    check(layerZ.length == 2, "two layers");

    // Cura sets the fan between ;LAYER: and the layer's first move: the marker stays before the fan command and takes
    // its height from the move after it, so the layer is 0.3 mm tall, not 0.6 mm measured from the previous layer.
    var fan = compile("M83\nM104 S200\nM109 S200\nG0 F3600 X10 Y10 Z0.3\n;LAYER:0\nG1 F1800 X20 Y10 E0.37\n" +
      ";LAYER:1\nM106 S255\nG0 F3600 X10 Y10 Z0.6\nG1 F1800 X20 Y10 E0.37\nM2\n");
    check(errors(fan).length == 0, "the fan between ;LAYER: and its move: no errors: " + errors(fan));
    var fanLayers = [for (item in layersOf(fan.program.ops)) Math.round(item.z * 1e7)];
    check(fanLayers.join(",") == "3000,6000", "the layer after the fan command sits at its first move's Z: " + fanLayers);
    var order = tags(fan.program.ops);
    check(order.indexOf("layer 1") >= 0 && order.indexOf("layer 1") < order.indexOf("fan part 255"),
      "the layer marker precedes its fan command: " + order.join("|"));
    var heights:Array<Int> = [];
    for (op in fan.program.ops) switch op {
      case Deposit(_, _, height, _): heights.push(Math.round(height * 1e7));
      case _:
    }
    check(heights.join(",") == "3000,3000", "both layers' beads are 0.3 mm tall: " + heights);
  }

  static function orca():Void {
    // Klipper flavour: object labels, arcs, a pressure-advance command and a start macro the toolpath does not model.
    var result = compile("; generated by OrcaSlicer\nM83\nG28\nEXCLUDE_OBJECT_DEFINE NAME=Part_1 CENTER=10,10 POLYGON=[[0,0],[20,0],[20,20]]\n" +
      "START_PRINT BED=60 EXTRUDER=210\nSET_PRESSURE_ADVANCE ADVANCE=0.04\nSET_HEATER_TEMPERATURE HEATER=extruder TARGET=210\n" +
      "TEMPERATURE_WAIT SENSOR=extruder MINIMUM=209\nG1 X10 Y0 Z.2 F6000\n; printing object Part_1 id:0 copy 0\nEXCLUDE_OBJECT_START NAME=Part_1\n" +
      ";LAYER_CHANGE\n;Z:0.2\n; FEATURE: Outer wall\nG1 X20 Y0 E.3 F3000\nG3 X20 Y10 I0 J5 E.3\n; FEATURE: Sparse infill\nG1 X10 Y10 E.25\n" +
      "EXCLUDE_OBJECT_END NAME=Part_1\n; stop printing object Part_1 id:0 copy 0\nSET_FAN_SPEED FAN=chamber_fan SPEED=0.5\nM486 S0 A\"Thing\"\nM486 S-1\n");
    check(errors(result).length == 0, "an Orca file has no errors: " + errors(result));
    var list = tags(result.program.ops).join("|");
    check(list.indexOf("heat hotend 210 wait") >= 0, "TEMPERATURE_WAIT after SET_HEATER_TEMPERATURE makes the wait: " + list);
    check(list.indexOf("object Part_1 start") >= 0 && list.indexOf("object Part_1 end") >= 0, "object markers: " + list);
    check(list.indexOf("object Thing start") >= 0, "M486 names an object with A\"...\": " + list);
    check(list.indexOf("fan chamber_fan 128") >= 0, "SET_FAN_SPEED: " + list);
    check(warnings(result, "CNC_PRINTER_IGNORED") == 2, "the macro and the pressure advance are reported once each: " + warnings(result, "CNC_PRINTER_IGNORED"));
    var radii:Array<Float> = [], sweeps:Array<Float> = [];
    for (op in result.program.ops) switch op {
      case Move(Cut, Arc(_, radius, _, sweep), _, _, _): radii.push(radius); sweeps.push(sweep);
      case _:
    }
    check(radii.length == 1, "G3 is an arc");
    near(radii[0], 0.005, "of radius 5 mm", 1e-12);
    // The arc's bead is E over the arc length, not the chord.
    var arcLength = radii[0] * Math.abs(sweeps[0]);
    var area = Math.PI * 1.75 * 1.75 / 4.0 * 0.3 / (arcLength * 1000.0);
    var areas = beadAreas(result.program.ops);
    relative(areas[1], area, "the arc is deposited by arc length", 1e-9);
  }

  static function firmware():Void {
    // M220 scales speeds and M221 scales the extrusion from there on.
    var result = compile("M83\nG1 X10 F6000\nM220 S50\nG1 X20 E.5\nM221 S200\nG1 X30 E.5\nM220 S100\nM221 S100\nG1 X40 E.5\n");
    var speeds:Array<Float> = [], areas = beadAreas(result.program.ops);
    for (op in result.program.ops) switch op {
      case Move(_, _, speed, _, _): speeds.push(speed);
      case _:
    }
    near(speeds[0], 0.1, "F6000 is 100 mm/s");
    near(speeds[1], 0.05, "M220 S50 halves it", 1e-12);
    relative(areas[1] / areas[0], 2.0, "M221 S200 doubles the extrusion per distance", 1e-9);
    check(areas.length == 3, "each change of flow starts a bead: " + areas.length);
    // E-only moves, G10/G11, a wipe, G92 E, units.
    var other = compile("M82\nG92 E0\nG1 E2 F600\nG1 X10 F3000\nG1 X20 E2.5\nG10\nG11\nG1 X30 E2.25\nG20\nG1 X1 F100\n");
    check(errors(other).length == 0, "no errors: " + errors(other));
    check(warnings(other, "CNC_PRINTER_WIPE") == 1, "a retract while moving is reported");
    var list = tags(other.program.ops);
    check(list[0] == "filament 2000", "an E-only move primes: " + list);
    check(list.indexOf("filament -800") >= 0 && list.indexOf("filament 800") >= 0, "G10 and G11 use the firmware retract: " + list);
    check(list.indexOf("filament -250") >= 0, "the wipe's retract is a filament move: " + list);
    var last = other.program.ops[other.program.ops.length - 1];
    var tip:Point3 = cast endOf(last);
    near(tip.x, 0.0254, "G20 reads inches", 1e-12);
    // Moves need a feed rate, G92 on an axis is refused, an unknown code is refused with its line.
    check(errors(compile("G1 X10\n")).length == 1, "a move before any F is refused");
    var bad = compile("G1 X1 F100\nG92 X0\nM999\nG1 X2 G1 Y3\nG1 X3\n");
    var failed = errors(bad);
    check(failed.length == 3 && failed[0].span.line == 2 && failed[1].span.line == 3 && failed[2].span.line == 4,
      "each refused line is reported once and the rest still compile: " + failed);
    check(bad.program.ops.length == 2, "the good lines survive");
  }

  static function refused():Void {
    var rejected = false;
    try new CncController(LinuxCnc, null, new PrinterSettings()) catch (_:Dynamic) rejected = true;
    check(rejected, "a LinuxCNC controller has no printer settings");
    var defaults:PrinterSettings = cast new CncController(Printer).printer;
    check(defaults.filamentDiameter == 0.00175, "a printer controller defaults to 1.75 mm filament");
    // LinuxCNC still refuses the printer's words.
    var cnc = CncCompiler.compileDetailed("G21 G90\nG1 X10 E1 F100\nM104 S200\nM2\n", new CncController(LinuxCnc));
    var failed = errors(cnc);
    check(failed.length == 2, "LinuxCNC refuses E words and M104: " + failed);
    // The LinuxCNC writer never sees a printer program (AM1), and the printer writer refuses CNC operations.
    var span = Provenance.cam(1);
    var cncOnly = new ToolpathProgram([ToolpathOp.Spindle(Clockwise, 1000, span)], new ToolLibrary(), [new Setup("1", new Point3(0, 0, 0))]);
    var message = "";
    try PrinterWriter.write(cncOnly, controller()) catch (error:Dynamic) message = Std.string(error);
    check(message.indexOf("no spindle") >= 0, "the printer writer refuses a spindle: " + message);
    message = "";
    try PrinterWriter.write(cncOnly, new CncController(LinuxCnc)) catch (error:Dynamic) message = Std.string(error);
    check(message.indexOf("printer controller") >= 0, "and a CNC controller");
    message = "";
    var heater = new ToolpathProgram([ToolpathOp.Heat("tank", 40, false, span)], new ToolLibrary(), [new Setup("1", new Point3(0, 0, 0))]);
    try PrinterWriter.write(heater, controller(), Marlin) catch (error:Dynamic) message = Std.string(error);
    check(message.indexOf("no heater") >= 0, "Marlin has no generic heater: " + message);
    check(PrinterWriter.write(heater, controller(), Klipper).indexOf("SET_HEATER_TEMPERATURE HEATER=tank TARGET=40") >= 0,
      "Klipper has");
  }

  /** A hand-built layer with a rounded rectangle, an arc and every printing operation. */
  static function layerProgram():ToolpathProgram {
    var span = Provenance.cam(3);
    var bead = 0.00000008, width = 0.00045, height = 0.0002;
    var z = 0.0002;
    function p(x:Float, y:Float):Point3 return new Point3(x * 0.001, y * 0.001, z);
    function line(a:Point3, b:Point3, kind:toolpathkit.path.MoveKind = Cut):ToolpathOp
      return ToolpathOp.Move(kind, PathGeometry.Line(a, b), kind == Cut ? 0.04 : 0.15, 0.0001, span);
    var ops:Array<ToolpathOp> = [
      ToolpathOp.Heat("bed", 60, true, span), ToolpathOp.Heat("hotend", 210, true, span), ToolpathOp.Fan("part", 1.0, span),
      ToolpathOp.PrintObject("tab", true, span), ToolpathOp.Layer(0, z, span), ToolpathOp.Feature(ExternalPerimeter, span),
      line(p(50, 50), p(60, 50), Rapid),
      ToolpathOp.Deposit(bead, width, height, span),
      line(p(60, 50), p(70, 50)), line(p(70, 50), p(70, 60)),
      ToolpathOp.Move(Cut, PathGeometry.Arc(new Point3(0.065, 0.06, z), 0.005, 0.0, Math.PI), 0.04, 0.0001, span),
      ToolpathOp.Feature(Infill, span),
      line(p(60, 60), p(60, 52)), ToolpathOp.DepositOff(span),
      ToolpathOp.FilamentMove(-0.0008, 0.035, span), line(p(60, 52), p(55, 52), Rapid), ToolpathOp.FilamentMove(0.0008, 0.035, span),
      ToolpathOp.Dwell(0.5, span),
      ToolpathOp.Layer(1, 2 * z, span), ToolpathOp.Deposit(bead, width, height, span), line(p(55, 52), p(56, 52)),
      ToolpathOp.PrintObject("tab", false, span),
      ToolpathOp.Fan("part", 0.0, span), ToolpathOp.Heat("hotend", 0, false, span), ToolpathOp.Heat("bed", 0, false, span), ToolpathOp.End(span)];
    return new ToolpathProgram(ops, new ToolLibrary(), [new Setup("1", new Point3(0, 0, 0))]);
  }

  static function roundTrips():Void {
    var program = layerProgram();
    var original = program.depositedVolume();
    for (flavour in [Klipper, Marlin]) {
      var text = PrinterWriter.write(program, controller(), flavour);
      var back = compile(text);
      var label = Std.string(flavour);
      check(errors(back).length == 0, '$label: the written file reads back without errors: ${errors(back)}\n$text');
      relative(back.program.depositedVolume(), original, "deposited volume survives IR -> G-code -> IR", 0.001);
      var layers = back.program.layerVolumes();
      check(layers.length == 2 && layers[0].index == 0 && layers[1].index == 1, "$label: layers survive");
      relative(layers[0].volume, program.layerVolumes()[0].volume, "layer 0's volume", 0.001);
      var objects = back.program.objectVolumes();
      check(objects.length == 1 && objects[0].name == "tab", '$label: the object survives');
      // Geometry within 1 um: every move ends where it did, and arcs stay arcs.
      var before = [for (op in program.ops) if (endOf(op) != null) op], after = [for (op in back.program.ops) if (endOf(op) != null) op];
      check(before.length == after.length, '$label: same moves');
      for (index in 0...before.length) {
        var a:Point3 = cast endOf(before[index]), b:Point3 = cast endOf(after[index]);
        check(a.distanceTo(b) < 1e-6, '$label: move $index ends within 1 um (${a.distanceTo(b)})');
        check(tag(before[index]) == tag(after[index]), '$label: move $index keeps its kind');
      }
      // Markers, temperatures and fans come back in order; filament moves too.
      var markers = ["heat", "fan", "layer", "feature", "object", "filament", "dwell"];
      function markerTags(ops:Array<ToolpathOp>):String {
        var kept = [for (op in ops) if (markers.indexOf(tag(op).split(" ")[0]) >= 0) tag(op)];
        return kept.join("|");
      }
      check(markerTags(back.program.ops) == markerTags(program.ops), '$label: markers survive in order:\n${markerTags(back.program.ops)}\n${markerTags(program.ops)}');
      check(back.homes, '$label: the leading G28 is the program asking to home');
      // The same file read twice gives the same program.
      check(tags(compile(text).program.ops).join("|") == tags(back.program.ops).join("|"), '$label: deterministic');
    }
    check(PrinterWriter.write(program, controller(), Klipper).indexOf("EXCLUDE_OBJECT_DEFINE NAME=tab") >= 0, "Klipper defines the objects first");
    check(PrinterWriter.write(program, controller(), Marlin).indexOf('M486 S0 A"tab"') >= 0, "Marlin numbers them");
    // A controller without arcs gets chords, with the volume still right.
    var flat = PrinterWriter.write(program, controller(new PrinterSettings(0.00175, 0.0008, 0.035, 0.0, 0.035, 0.005, 0.0001, 0.0002, false)));
    check(("\n" + flat).indexOf("\nG3 ") < 0 && ("\n" + flat).indexOf("\nG2 ") < 0 && PrinterWriter.write(program, controller()).indexOf("\nG3 ") > 0,
      "no arcs for a controller without them, and arcs for one with");
    relative(compile(flat).program.depositedVolume(), original, "chords keep the volume", 0.001);
    // Reading rounds E to six decimals and merges beads within the tolerance; after that, writing is stable.
    var once = PrinterWriter.write(compile(PrinterWriter.write(program, controller())).program, controller());
    var twice = PrinterWriter.write(compile(once).program, controller());
    check(once == twice, 'writing what was read is a fixed point:\n$once\n----\n$twice');
    // LinuxCNC export is unchanged by any of this (its own tests cover the post).
    check(CncWriter.number(1.5) == "1.5", "number formatting is shared");
  }
}
